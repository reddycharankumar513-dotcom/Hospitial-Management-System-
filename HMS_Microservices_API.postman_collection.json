{
  "info": {
    "name": "HMS Microservices Intelligent Platform API",
    "description": "Complete Postman collection covering all 12 microservice feature modules.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "patientId",
      "value": "1"
    },
    {
      "key": "doctorId",
      "value": "1"
    },
    {
      "key": "appointmentId",
      "value": "1"
    },
    {
      "key": "labOrderId",
      "value": "1"
    },
    {
      "key": "prescriptionId",
      "value": "1"
    },
    {
      "key": "billId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "01 Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"admin@hms.com\", \"password\": \"admin123\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Register Patient User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"newpatient@hms.com\", \"password\": \"patient123\", \"firstName\": \"John\", \"lastName\": \"Doe\", \"role\": \"PATIENT\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "02 Patients",
      "item": [
